# OpenAll — Provider API Keys
# Copy this file to .env and fill in your keys.
# These are read ONLY by the Vite dev server proxy — never shipped to the browser.

# OpenRouter (free tier, :free model IDs)
OPENROUTER_API_KEY=

# Groq (free tier)
GROQ_API_KEY=

# Google AI Studio / Gemini (free tier)
GOOGLE_AI_KEY=

# Mistral (free plan)
MISTRAL_API_KEY=

# OpenAll Deep Research microservice (optional; leave blank to use the mock)
VITE_RESEARCH_URL=
VITE_RESEARCH_TOKEN=
