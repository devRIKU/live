  "effects": {
    "specularRim": {
      "intent": "A fake lighter border that reads as light catching the edge of glass.",
      "technique": "A true 1px gradient ring painted on a masked pseudo-element, so the edge never bleeds into a translucent face. Three gradient layers: a corner light at the top-left, a bounce off the bottom-right corner, and a vertical ramp that darkens the bottom edge.",
      "whyNotGradientBorder": "A background-clip gradient border needs an opaque face to mask the border-box layer, so it breaks on translucent surfaces under backdrop-filter.",
      "whyThreeLayers": "One 148deg linear gradient puts its dark stop off-element entirely on a 720x56 capsule. Corner and edge gradients are computed over the element box, so they behave on wide surfaces.",
      "whyNotInsetShadows": "Four flat inset shadows give a 1px line per edge with no falloff, and a white line on a white surface is invisible. A gradient ring carries the light through the falloff.",
      "utility": ".u-specular",
      "focus": "data-focused=\"true\" swaps the ring for --spec-ring-focus, so focus re-lights the rim instead of drawing a halo around the control.",
      "value": "{semantic.light.specRing}"
    },
    "edgeGradient": {
      "intent": "True gradient edge for opaque surfaces.",
      "technique": "background: face padding-box + edge gradient border-box",
      "utility": ".u-edge-gradient"
    },
    "sheen": {
      "intent": "The Liquid Glass sweep — a moving highlight that reveals on hover.",
      "utility": ".u-sheen",
      "duration": "{primitive.motion.duration.slow}ms"
    },
    "flowSpectrum": {
      "intent": "Sarvam's continuous blue→orange transition, used as a signal of flow.",
      "value": "linear-gradient(90deg, #393cc1 0%, #6a88e2 26%, #bed2ff 42%, #eaaf1c 66%, #d5650f 100%)",
      "utilities": [
        ".u-flow-text",
        ".u-flow-bar"
      ],
      "rule": "RESERVED. The spectrum may only appear in a flow state — generating, streaming, syncing. It is never a surface fill, never a card background, never decoration. If it is on screen, something is moving."
    },
    "pixelMotif": {
      "intent": "Mistral's chunky-pixel emblem construction.",
      "technique": "Two repeating-linear-gradients at a fixed pitch; a single accent pixel breaks the monochrome.",
      "utilities": [
        ".u-pixel",
        ".u-arch-grid"
      ],
      "rule": "Opacity ceiling 0.06 for ambient texture. The accent pixel is always exactly one."
    },
    "aurora": {
      "intent": "A slow ambient wash behind the canvas during generation.",
      "value": "{semantic.light.flowAurora}",
      "rule": "Ceiling 0.08 opacity, and only while a flow state is active. It must never reduce the contrast of body text."
    }
  },
  "component": {
    "composer": {
      "radius": "{semantic.component.composerRadius}",
      "chipRadius": "{semantic.component.composerChipRadius}",
      "padding": "{primitive.space.2}",
      "height": 52,
      "concentricity": "composer radius 26 − padding 8 = chip radius 18"
    },
    "sidebar": {
      "width": 244,
      "rowRadius": "{primitive.radius.fixed.sm}",
      "material": "translucent + backdrop-filter"
    },
    "popover": {
      "radius": "{primitive.radius.fixed.2xl}",
      "border": "{primitive.borderWidth.thin} solid {semantic.light.separator}",
      "shadow": "{primitive.elevation.3}",
      "origin": "scales from the trigger, not from centre"
    },
    "bubble": {
      "radius": "{primitive.radius.fixed.xl}",
      "fill": "{semantic.light.fill1}"
    },
    "send": {
      "size": 36,
      "radius": "50% (capsule)",
      "states": [
        "send",
        "stop"
      ]
    },
    "messageColumn": {
      "width": 720,
      "gap": 26
    },
    "accountMenu": {
      "anchor": "profile row in the sidebar footer, opens upward",
      "origin": "0 100%",
      "items": [
        "Settings",
        "Keyboard shortcuts",
        "Reset demo"
      ],
      "destructive": "two-step confirmation"
    },
    "settings": {
      "surface": "modal",
      "width": "720px",
      "nav": "178px column, horizontal strip below 860px",
      "controls": [
        "segmented",
        "switch",
        "field"
      ],
      "persistence": "localStorage: lively.prefs",
      "implements": [
        "theme",
        "reduceMotion",
        "enterToSend",
        "showEffort",
        "name",
        "instructions",
        "improve"
      ]
    }
  },
  "rules": [
    "Semantic names only in component CSS. Primitives are never referenced outside tokens.css.",
    "The flow spectrum appears only in a flow state. It is a signal, never a surface.",
    "Exactly one accent pixel per pixel emblem.",
    "Ambient texture (pixel grid, aurora, arch grid) stays at or below 0.06 opacity when it is decoration.",
    "Radii come from the HIG taxonomy: fixed, capsule, or concentric. Never an arbitrary value.",
    "UI animation never exceeds 300ms. Entrance uses ease-out; movement uses ease-in-out.",
    "Only transform and opacity animate.",
    "Under prefers-reduced-motion, remove movement but keep opacity and colour, and keep the streaming caret visible.",
    "Light and dark are the same tokens with different values. No component may branch on theme."
  ],
  "files": {
    "tokens": "design-system/tokens.css",
    "motion": "design-system/motion.css",
    "shell": "design-system/lively-app.css",
    "settings": "design-system/lively-settings.js",
    "spec": "design-system/design-system.md",
    "styleguide": "design-system/styleguide.html",
    "mockups": "openall-mockups/",
    "app": "Chat UI v3.html"
  },
  "theme": {
    "mechanism": "light-dark()",
    "note": "One palette, two states. light-dark() reads color-scheme, so there is no second copy of the tokens to drift.",
    "resolution": {
      "default": ":root { color-scheme: light dark; }  — the OS decides",
      "userOverride": ":root[data-theme=\"light\"] / :root[data-theme=\"dark\"] — the Settings dialog sets the attribute and stores it in localStorage"
    },
    "rules": [
      "light-dark() carries colours only. A shadow keeps its geometry and borrows a theme-aware colour via --shadow-color-*.",
      "A theme override is one attribute on <html>, not a second stylesheet.",
      "Components never branch on theme."
    ]
  }
}
