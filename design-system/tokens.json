{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Lively Design System",
  "version": "1.2.0",
  "updated": "2026-10-21",
  "description": "Token set for the Lively assistant chat UI. Three-layer architecture: primitive → semantic → component, plus effects and motion.",
  "sources": {
    "apple-hig": {
      "url": "https://developer.apple.com/design/human-interface-guidelines",
      "contributes": [
        "semantic colour roles (label / separator / systemFill family)",
        "shape taxonomy: fixed, capsule, concentric",
        "material layers and translucency",
        "type scale and ~1.3x leading",
        "44pt minimum touch target"
      ]
    },
    "sarvam-ai": {
      "url": "https://www.sarvam.ai/brand",
      "contributes": [
        "the blue-to-orange flow spectrum",
        "gradient construction (180deg two-stop, saturated to bright)"
      ],
      "extractedTokens": {
        "--color-br-blue": "#393cc1",
        "--color-br-orange": "#d5650f",
        "--color-sr-indigo-700": "#4250d5",
        "--color-sr-indigo-600": "#556adc",
        "--color-sr-indigo-500": "#6a88e2",
        "--gradient-orange": "linear-gradient(180deg,#d5650f 0%,#eaaf1c 100%)",
        "--gradient-blue": "linear-gradient(180deg,#bed2ff 0%,#393cc1 100%)"
      }
    },
    "mistral-ai": {
      "url": "https://mistral.ai/brand/",
      "contributes": [
        "pixel-emblem construction (chunky pixels, one accent pixel)",
        "hairline architectural grid",
        "warm paper canvas register"
      ],
      "extractedTokens": {
        "flame": "#ff6b00",
        "butter": "#fffaeb",
        "buttercream": "#fff0c2",
        "ink": "#1f1f1f"
      }
    }
  },
