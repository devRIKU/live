        "bold": 700
      },
      "fontSans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Helvetica Neue\", \"Segoe UI\", Roboto, sans-serif",
      "fontMono": "ui-monospace, Menlo, \"Cascadia Mono\", Consolas, monospace"
    },
    "elevation": {
      "0": "none",
      "1": "0 1px 2px rgba(0,0,0,.05), 0 1px 1px rgba(0,0,0,.03)",
      "2": "0 2px 8px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04)",
      "3": "0 12px 34px rgba(0,0,0,.16), 0 2px 8px rgba(0,0,0,.07)",
      "4": "0 24px 64px rgba(0,0,0,.22), 0 6px 16px rgba(0,0,0,.09)"
    },
    "motion": {
      "duration": {
        "instant": 90,
        "fast": 140,
        "base": 180,
        "slow": 260,
        "slower": 380,
        "entrance": 520
      },
      "easing": {
        "out": "cubic-bezier(0.23, 1, 0.32, 1)",
        "outQuart": "cubic-bezier(0.25, 1, 0.5, 1)",
        "outQuint": "cubic-bezier(0.22, 1, 0.36, 1)",
        "outExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
        "inOut": "cubic-bezier(0.77, 0, 0.175, 1)",
        "ios": "cubic-bezier(0.32, 0.72, 0, 1)",
        "spring": "cubic-bezier(0.22, 1.08, 0.36, 1)",
        "linear": "linear"
      },
      "stagger": {
        "step": 60,
        "cap": 320
      },
      "notes": {
        "spring": "Overshoot 0.08. Above ~0.1 it reads as dated for a serious product tool.",
        "exitFasterThanEntry": "Entrances use outExpo; exits are shorter, not differently curved.",
        "allowedProperties": [
          "transform",
          "opacity",
          "clip-path",
          "filter",
          "box-shadow"
        ],
        "bannedProperties": [
          "width",
          "height",
          "padding",
          "margin",
          "top",
          "left"
        ],
        "reducedMotion": {
          "principle": "Keep the state change, drop the travel.",
          "keep": [
            "opacity",
            "the streaming caret, visible and solid"
          ],
          "drop": [
            "transform",
            "clip-path",
            "filter",
            "all loops"
          ]
        }
      }
    }
  },
